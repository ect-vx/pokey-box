# Обязательно: API ключи для внешних сервисов
# Получить на: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Получить на: https://otx.alienvault.com/api (бесплатно)
OTX_API_KEY=

# Получить на: https://developers.google.com/safe-browsing (бесплатно)
SAFE_BROWSING_API_KEY=

# Опционально — переопределить дефолты
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sandbox
RUST_LOG=info
